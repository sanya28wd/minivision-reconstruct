# Copy to .env.test (gitignored); worktrees fall back to the main checkout's file.
# Docker container incident-pg. Never put a password inside a URL: libpq reads PGPASSWORD.
PGPASSWORD=postgres
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/postgres
# Folder holding pg_dump 16 or newer, if it is not on PATH.
INCIDENT_PG_BIN_DIR=C:/Users/HP/tools/pgsql16/pgsql/bin

# TEST_DATABASE_URL above is an admin connection used only to create throwaway test databases.
# App storage is separate: DATABASE_URL=postgresql://postgres@localhost:5433/incidentdesk_dev
# Tests create, migrate and drop isolated databases; they do not store app data in postgres.
